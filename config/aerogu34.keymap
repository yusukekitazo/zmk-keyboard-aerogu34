#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <mouse-gesture.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// OS設定を日本語キーボードのまま使用するための変換定義

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };

    combos {
        compatible = "zmk,combos";

        Bt {
            bindings = <&mo 6>;
            key-positions = <30 31>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        scroll {
            bindings = <&mo 5>;
            key-positions = <17 18>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        control {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <20 21>;
        };

        alt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <21 22>;
        };

        gui {
            bindings = <&kp LEFT_GUI>;
            key-positions = <22 23>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <27 28>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <28 29>;
        };

        /* J+K+L held (3-key combo): activates trackball gesture
         * recognition. Distinct from the 2-key "scroll" combo (K+L)
         * above -- ZMK resolves the overlap by waiting up to timeout-ms
         * for the 3rd key; K+L alone (no J within the window) fires
         * "scroll", J+K+L fires this instead.
         * timeout/require-prior-idle mirror the Bt/scroll mode-switch
         * combos to avoid misfiring while typing normal J/K/L characters. */

        mouse_gesture_activate {
            bindings = <&mouse_gesture>;
            key-positions = <16 17 18>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    macros {
        Macmode: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&bt BT_SEL 1>,
                <&macro_wait_time 200>,
                <&macro_tap>,
                <&tog 0>;

            label = "NEW_MACRO";
        };

        app_switcher: app_switcher {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp UP_ARROW>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "APP_SWITCHER";
        };

        controlcenter: controlcenter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp C>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "CONTROLCENTER";
        };

        tuutincenter: tuutincenter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp N>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "TUUTINCENTER";
        };

        docs: docs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp A>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "DOCS";
        };

        applist: AppList {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp LS(A)>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "APPLIST";
        };

        homegamen: homegamen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp H>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "HOMEGAMEN";
        };

        slideover1: slideover1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp LA(LEFT_ARROW)>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "SLIDEOVER1";
        };

        slideover2: slideover2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp LA(RIGHT_ARROW)>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "SLIDEOVER2";
        };

        Quicknote: Quicknote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp Q>,
                <&macro_release>,
                <&kp GLOBE>;

            label = "QUICKNOTE";
        };

        windowsime: windowsime {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp LEFT_SHIFT>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "WINDOWSIME";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
&kp Q        &kp W            &kp E  &kp R  &kp T  &kp Y        &kp U        &kp I      &kp O    &kp P
&kp A        &kp S            &kp D  &kp F  &kp G  &kp H        &kp J        &kp K      &kp L    &mt RIGHT_SHIFT MINUS
&kp Z        &kp X            &kp C  &kp V  &kp B  &kp N        &kp M        &kp COMMA  &kp DOT  &kp SLASH
&lt 2 SPACE  &lt 3 BACKSPACE                       &lt 4 ENTER  &windowsime
            >;
        };

        MOUSE {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans  &trans
&trans  &trans                          &trans  &trans
            >;
        };

        MARK1 {
            display-name = "Mark1";
            bindings = <
&kp EXCLAMATION       &kp JP_AT             &kp HASH           &kp DOLLAR       &kp PERCENT          &kp JP_CARET       &kp JP_AMPERSAND  &kp JP_ASTERISK  &kp JP_LPAREN    &kp JP_RPAREN
&kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp LA(PRINTSCREEN)  &kp JP_UNDERSCORE  &kp JP_EQUAL      &kp JP_LBRACKET  &kp JP_RBRACKET  &kp JP_TILDE
&trans                &trans                &kp LC(MINUS)      &kp LC(PLUS)     &kp LC(N0)           &kp JP_DQUOTE      &kp JP_COLON      &kp LS(COMMA)    &kp LS(PERIOD)   &kp LS(SLASH)
&trans                &mo 3                                                                          &trans             &trans
            >;
        };

        NUM1 {
            display-name = "Num1";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp N0
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5  &kp F6        &kp F7        &kp F8        &kp F9        &kp F12
&kp LC(Z)     &kp LC(X)     &kp LC(C)     &kp LC(V)     &trans  &trans        &trans        &trans        &trans        &trans
&trans        &trans                                            &kp INSERT    &kp LC(W)
            >;
        };

        CURSOR1 {
            display-name = "Cursor1";
            bindings = <
&kp LA(Q)      &kp LA(W)  &kp LEFT_GUI            &kp LA(TAB)              &kp LA(F4)  &kp LC(W)           &kp LC(T)            &kp UP_ARROW    &kp LS(LC(TAB))  &kp LC(TAB)
&kp LG(O)      &kp LG(W)  &kp LG(LC(LEFT_ARROW))  &kp LG(LC(RIGHT_ARROW))  &kp LA(E)   &kp LC(R)           &kp LEFT_ARROW       &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LC(F)
&kp LG(SLASH)  &trans     &kp LG(N)               &kp LA(C)                &kp LA(R)   &kp LA(LEFT_ARROW)  &kp LA(RIGHT_ARROW)  &kp LS(LC(B))   &kp RG(A)        &kp LC(L)
&kp LA(S)      &kp LG(H)                                                               &trans              &trans
            >;
        };

        SCROLL {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &kp LEFT_SHIFT  &kp LCTRL  &trans      &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans          &trans     &kp RSHIFT  &trans  &trans  &trans  &kp RCTRL
&trans  &trans  &trans  &trans          &trans     &trans      &trans  &trans  &trans  &trans
&trans  &trans                                     &trans      &trans
            >;
        };

        WIRELESS {
            display-name = "Wireless";
            bindings = <
&bt BT_SEL 0  &Macmode  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans    &trans        &trans        &bootloader   &trans        &trans          &trans        &trans        &trans
&trans        &trans    &trans        &trans        &trans        &trans        &trans          &trans        &trans        &bt BT_CLR
&trans        &trans                                              &bootloader   &studio_unlock
            >;
        };
    };
};
