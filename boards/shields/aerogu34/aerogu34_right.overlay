#include "aerogu34.dtsi"
#include <behaviors.dtsi>
#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>
#include <dt-bindings/zmk/runtime_input_processor.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/modifiers.h>
#include <mouse-gesture.dtsi>

&default_transform {
    col-offset = <5>;
};

&xiao_serial { status = "disabled"; };

/* Disable I2C0 to prevent conflict with SPI0 (same hardware peripheral). */
&i2c0 { status = "disabled"; };

/* Disable the board's default UART-over-USB-CDC-ACM endpoint.
 * Zephyr 4's xiao_ble board unconditionally adds a second CDC ACM USB
 * function for console/shell. With the studio-rpc-usb-uart snippet that
 * adds another CDC ACM for the Studio RPC channel, the device ends up
 * exposing two CDC ACMs and DYA Studio's Web Serial port-open fails
 * ("The port is already open" / wrong port chosen). We don't use the
 * console, so drop the node. */
&board_cdc_acm_uart { status = "disabled"; };

/* AML (auto-mouse-layer) via the static zip_temp_layer processor.
 * cormoran's mouse_runtime_input_processor's temp-layer feature does NOT
 * support excluded-positions / require-prior-idle-ms, so it can't do
 * typing-misfire prevention. AML layer/timeout are build-time fixed
 * (not Studio-editable) as a result -- confirmed not needed.
 *
 * J/K/Lをタイプした直後300ms以内はAMLが発動しない(トラボ誤爆防止)。
 * SCROLLレイヤー(下のscroller_v)では意図的にこのAMLを外している
 * (すでにSCROLLレイヤーにいる間はMOUSEレイヤーへ切り替える必要がない)。 */
&zip_temp_layer {
    excluded-positions = <
        16 // J
        17 // K
        18 // L
    >;
    require-prior-idle-ms = <300>;
};

/* Mouse gesture: activated only while the K+L combo (keymap.keymap) is
 * held. Movement IS suppressed while active, so gesture strokes don't
 * also move the cursor/scroll underneath. Normal trackball use (no combo
 * held) is completely unaffected.
 *
 * 矢印の向きと一致: 右に転がす→進む、左に転がす→戻る。
 * 上下: タブ切り替え(上=次のタブ、下=前のタブ)。上下のapp-switchは
 * 発火しなかったため、tab切り替えに変更。 */
&zip_mouse_gesture {
    stroke-size = <300>;
    enable-eager-mode;
    suppress-movement;

    forward {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LA(RIGHT_ARROW)>;  /* Alt+Right: forward */
    };

    back {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LA(LEFT_ARROW)>;   /* Alt+Left: back */
    };

    tab_next {
        pattern = <GESTURE_UP>;
        bindings = <&kp LC(TAB)>;          /* Ctrl+Tab: next tab */
    };

    tab_prev {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LS(LC(TAB))>;      /* Ctrl+Shift+Tab: previous tab */
    };
};

/ {
    deadzone_processor: deadzone_processor {
        compatible = "zmk,input-processor-deadzone";
        #input-processor-cells = <0>;
        threshold = <10>;
        timeout-ms = <300>;
    };

    /* iOS-style scroll inertia (yusukekitazo fork of
     * mjmjm0101/zmk-input-processor-scroll-inertia).
     * Replaces amgskobo/zmk-input-inertia -- that module's decay behavior
     * was undocumented and several tuning rounds didn't converge on a
     * consistent feel. This module documents decay as a per-tick
     * retention multiplier (990 = velocity *= 0.990/tick) plus a
     * separate `friction` knob for taming short flicks independently.
     *
     * NOTE: previous build failed with a duplicate-label error because
     * a custom zip_wheel_scaler node was added here, colliding with the
     * one already defined in aerogu34.keymap's input_processors block.
     * Per the module author's own working example, the correct
     * end-of-chain scaler is the built-in &zip_scroll_scaler -- no
     * custom node needed here at all.
     *
     * axis=1 (Y/vertical) is the primary scroll axis for the SCROLL
     * layer. swap-mod lets Shift flip to horizontal scroll on demand
     * without needing a second layer.
     *
     * scale/scale-div (4/675) and the starting decay values are the
     * module's own documented defaults for a 1000 CPI PMW3610 @ 125Hz --
     * close to this board's PAW3222 setup, so they're a reasonable
     * starting point. Untested on this hardware yet; may need tuning
     * after flashing. */
    scroll_inertia_v: scroll_inertia_v {
        compatible = "zmk,input-processor-scroll-inertia";
        #input-processor-cells = <0>;

        axis  = <1>;   /* Y axis only (vertical) */
        layer = <5>;   /* SCROLL layer */

        scale     = <4>;
        scale-div = <675>;

        /* Hold Shift to scroll horizontally instead */
        swap-mod = <(MOD_LSFT|MOD_RSFT)>;
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        /* Default chain (all layers except SCROLL, see scroller_v below):
         *   deadzone      - filter sub-threshold noise
         *   xy_transform  - invert both axes (sensor-mounting orientation)
         *   mouse_gesture - active only while K+L combo held; suppresses
         *                   movement downstream during an active gesture
         *   temp_layer    - auto-mouse-layer -> MOUSE(1), 1000ms timeout,
         *                   excludes J/K/L with 300ms prior-idle requirement
         *
         * No inertia on cursor movement -- confirmed not wanted. */
        input-processors = <&deadzone_processor
                            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
                            &zip_mouse_gesture
                            &zip_temp_layer 1 1000>;

        /* SCROLL layer (index5, entered via the J+K combo) override:
         * same deadzone/orientation/gesture handling, but XY is mapped
         * to scroll and run through the new inertia processor instead
         * of the temp-layer AML (already intentionally in this layer). */
        scroller_v {
            layers = <5>;
            input-processors = <&deadzone_processor
                                &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
                                &zip_mouse_gesture
                                &zip_xy_to_scroll_mapper
                                &scroll_inertia_v
                                &zip_scroll_scaler 4 675>;
        };
    };
};

&spi0 {
    status = "okay";

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,paw3222";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        /* Boot-time sensor CPI (counts per inch). Valid range 608-4826 in
         * steps of 38; driver rounds down. 800 maps to 21*38 = 798.
         * DYA Studio's runtime-input-processor can override at runtime. */
        res-cpi = <800>;
    };
};