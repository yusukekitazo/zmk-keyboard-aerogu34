#include "aerogu34.dtsi"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/modifiers.h>
#include <mouse-gesture.dtsi>

&default_transform {
    col-offset = <5>;
};

&xiao_serial { status = "disabled"; };
&i2c0 { status = "disabled"; };

/* ----------------------------------------------------
 * AML (Auto Mouse Layer) 設定
 * J(16), K(17), L(18) のキー打鍵後300ms以内は
 * トラックボールを動かしてもMOUSEレイヤーへ遷移しない（誤爆防止）
 * ---------------------------------------------------- */
&zip_temp_layer {
    excluded-positions = <
        16 // J
        17 // K
        18 // L
    >;
    require-prior-idle-ms = <300>;
};

/* ----------------------------------------------------
 * Mouse Gesture 設定 (K+Lコンボ中に発動)
 * ---------------------------------------------------- */
&zip_mouse_gesture {
    stroke-size = <300>;
    enable-eager-mode;
    suppress-movement;

    forward {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LA(RIGHT_ARROW)>;  /* Alt+Right: 進む */
    };

    back {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LA(LEFT_ARROW)>;   /* Alt+Left: 戻る */
    };

    tab_next {
        pattern = <GESTURE_UP>;
        bindings = <&kp LC(TAB)>;          /* Ctrl+Tab: 次のタブ */
    };

    tab_prev {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LS(LC(TAB))>;      /* Ctrl+Shift+Tab: 前のタブ */
    };
};

/ {
    deadzone_processor: deadzone_processor {
        compatible = "zmk,input-processor-deadzone";
        #input-processor-cells = <0>;
        threshold = <10>;
        timeout-ms = <300>;
    };

    /* SCROLLレイヤー(J+K)用慣性スクロール設定 */
    scroll_inertia_v: scroll_inertia_v {
        compatible = "zmk,input-processor-scroll-inertia";
        #input-processor-cells = <0>;

        axis  = <1>;   /* Y軸 (縦スクロール) */
        layer = <5>;   /* SCROLLレイヤー */

        scale     = <4>;
        scale-div = <675>;

        swap-mod = <(MOD_LSFT|MOD_RSFT)>; /* Shiftキー保持で横スクロール化 */
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;

        /* 通常時 (MOUSEレイヤー発動チェイン) */
        input-processors = <&deadzone_processor
                            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
                            &zip_mouse_gesture
                            &zip_temp_layer 1 1000>; /* MOUSEレイヤー(1)へ自動遷移 (1000msタイムアウト) */

        /* J+K同時押し時 (SCROLLレイヤー: index 5) */
        scroller_v {
            layers = <5>;
            input-processors = <&deadzone_processor
                                &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
                                &zip_mouse_gesture
                                &zip_xy_to_scroll_mapper
                                &scroll_inertia_v
                                &zip_scroll_scaler 4 675>;
        };
    };
};

&spi0 {
    status = "okay";

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,paw3222";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        res-cpi = <800>;
    };
};
