#include "aerogu34.dtsi"
#include <behaviors.dtsi>
#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>
#include <dt-bindings/zmk/runtime_input_processor.h>
#include <dt-bindings/zmk/input_transform.h>
#include <mouse-gesture.dtsi>

&default_transform {
    col-offset = <5>;
};

&xiao_serial { status = "disabled"; };

/* Disable I2C0 to prevent conflict with SPI0 (same hardware peripheral). */
&i2c0 { status = "disabled"; };

/* Disable the board's default UART-over-USB-CDC-ACM endpoint.
 * Zephyr 4's xiao_ble board unconditionally adds a second CDC ACM USB
 * function for console/shell. With the studio-rpc-usb-uart snippet that
 * adds another CDC ACM for the Studio RPC channel, the device ends up
 * exposing two CDC ACMs and DYA Studio's Web Serial port-open fails
 * ("The port is already open" / wrong port chosen). We don't use the
 * console, so drop the node. */
&board_cdc_acm_uart { status = "disabled"; };

&scroll_runtime_input_processor {
    processor-label = "rscroll";
    x-codes = <INPUT_REL_X>;
    y-codes = <INPUT_REL_Y>;
    xy-to-scroll-enabled;
    active-layers = <32>;  /* BIT(5) = layer 5 (SCROLL) */
    axis-snap-mode = <AXIS_SNAP_MODE_Y>;
    axis-snap-threshold = <200>;
};

/* Auto-mouse-layer is now handled by mouse_runtime_input_processor itself
 * (temp-layer-* properties below), instead of a separate static
 * &zip_temp_layer node. This makes it editable from DYA Studio at runtime
 * (enable/disable, target layer, activation/deactivation delay).
 *
 * excluded-positions / require-prior-idle-ms: トラボ誤爆防止。
 * J/K/Lをタイプした直後300ms以内はAMLが発動しない。 */
&mouse_runtime_input_processor {
    temp-layer-enabled;
    temp-layer = <1>;                          /* MOUSE layer (index1) */
    temp-layer-activation-delay-ms = <0>;      /* activate immediately on movement */
    temp-layer-deactivation-delay-ms = <1000>; /* same 1s timeout as before */
    excluded-positions = <
        16 // J
        17 // K
        18 // L
    >;
    require-prior-idle-ms = <300>;
};

/* Mouse gesture: activated only while the K+L combo (keymap.keymap) is
 * held. Movement IS suppressed while active, so gesture strokes don't
 * also move the cursor/scroll underneath. Normal trackball use (no combo
 * held) is completely unaffected. */
&zip_mouse_gesture {
    stroke-size = <300>;
    enable-eager-mode;
    suppress-movement;

    back {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LA(LEFT_ARROW)>;   /* Alt+Left: back */
    };

    forward {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LA(RIGHT_ARROW)>;  /* Alt+Right: forward */
    };

    app_switch_up {
        pattern = <GESTURE_UP>;
        bindings = <&kp LA(Q)>;            /* Alt+Q: app switch */
    };

    app_switch_down {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LA(W)>;            /* Alt+W: app switch */
    };
};

/ {
    deadzone_processor: deadzone_processor {
        compatible = "zmk,input-processor-deadzone";
        #input-processor-cells = <0>;
        threshold = <10>;
        timeout-ms = <300>;
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        /* Chain order:
         *   deadzone      - filter sub-threshold noise
         *   xy_transform  - invert both axes (sensor-mounting orientation)
         *   mouse_gesture - active only while K+L combo held; suppresses
         *                   movement downstream during an active gesture
         *   mouse_runtime - DYA Studio runtime config (CPI / snipe / temp-layer / etc)
         *   scroll_runtime - convert XY -> scroll on layer 5 only
         *
         * NOTE: the old static "&zip_temp_layer 4 1000" entry has been
         * removed; auto-mouse-layer is now configured on
         * mouse_runtime_input_processor above so it's Studio-editable. */
        input-processors = <&deadzone_processor
                            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
                            &zip_mouse_gesture
                            &mouse_runtime_input_processor
                            &scroll_runtime_input_processor>;
    };
};

&spi0 {
    status = "okay";

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,paw3222";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        /* Boot-time sensor CPI (counts per inch). Valid range 608-4826 in
         * steps of 38; driver rounds down. 800 maps to 21*38 = 798.
         * DYA Studio's runtime-input-processor can override at runtime. */
        res-cpi = <800>;
    };
};