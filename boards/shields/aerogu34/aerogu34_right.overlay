#include "aerogu34.dtsi"
#include <behaviors.dtsi>
#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>
#include <dt-bindings/zmk/runtime_input_processor.h>
#include <dt-bindings/zmk/input_transform.h>
#include <mouse-gesture.dtsi>
#include <zmk-input-inertia/input/processor/input_inertia.dtsi>

&default_transform {
    col-offset = <5>;
};

&xiao_serial { status = "disabled"; };

/* Disable I2C0 to prevent conflict with SPI0 (same hardware peripheral). */
&i2c0 { status = "disabled"; };

/* Disable the board's default UART-over-USB-CDC-ACM endpoint.
 * Zephyr 4's xiao_ble board unconditionally adds a second CDC ACM USB
 * function for console/shell. With the studio-rpc-usb-uart snippet that
 * adds another CDC ACM for the Studio RPC channel, the device ends up
 * exposing two CDC ACMs and DYA Studio's Web Serial port-open fails
 * ("The port is already open" / wrong port chosen). We don't use the
 * console, so drop the node. */
&board_cdc_acm_uart { status = "disabled"; };

&scroll_runtime_input_processor {
    processor-label = "rscroll";
    x-codes = <INPUT_REL_X>;
    y-codes = <INPUT_REL_Y>;
    xy-to-scroll-enabled;
    active-layers = <32>;  /* BIT(5) = layer 5 (SCROLL) */
    axis-snap-mode = <AXIS_SNAP_MODE_Y>;
    axis-snap-threshold = <200>;
};

/* Inertia processor: continues movement/scroll after input stops, with
 * exponential decay. Placed at the END of the trackball_listener chain
 * (see below) so it operates on the final processed values -- after
 * scroll_runtime_input_processor has decided move-vs-scroll for the
 * current layer. Since move and scroll share this single chain (no
 * separate layer-branches), one shared &zip_inertia instance covers
 * both cases automatically. */
&zip_inertia {
    trigger-ms = <35>;                  /* 2x the ~15ms sensor polling interval */

    move-decay-factor-int = <90>;
    move-report-interval-ms = <35>;
    move-threshold-start = <15>;
    move-threshold-stop = <1>;

    scroll-decay-factor-int = <85>;
    scroll-report-interval-ms = <65>;
    scroll-threshold-start = <2>;
    scroll-threshold-stop = <0>;

    cancel-scroll-inertia-on-ctrl;
};

/* AML (auto-mouse-layer) reverted to the static zip_temp_layer processor.
 * cormoran's mouse_runtime_input_processor's temp-layer feature does NOT
 * support excluded-positions / require-prior-idle-ms, so it can't do
 * typing-misfire prevention. AML layer/timeout are build-time fixed
 * (not Studio-editable) as a result -- confirmed not needed.
 *
 * J/K/Lをタイプした直後300ms以内はAMLが発動しない(トラボ誤爆防止)。 */
&zip_temp_layer {
    excluded-positions = <
        16 // J
        17 // K
        18 // L
    >;
    require-prior-idle-ms = <300>;
};

/* Mouse gesture: activated only while the K+L combo (keymap.keymap) is
 * held. Movement IS suppressed while active, so gesture strokes don't
 * also move the cursor/scroll underneath. Normal trackball use (no combo
 * held) is completely unaffected.
 *
 * 矢印の向きと一致: 右に転がす→進む、左に転がす→戻る。
 * 上下: タブ切り替え(上=次のタブ、下=前のタブ)。上下のapp-switchは
 * 発火しなかったため、tab切り替えに変更。 */
&zip_mouse_gesture {
    stroke-size = <300>;
    enable-eager-mode;
    suppress-movement;

    forward {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LA(RIGHT_ARROW)>;  /* Alt+Right: forward */
    };

    back {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LA(LEFT_ARROW)>;   /* Alt+Left: back */
    };

    tab_next {
        pattern = <GESTURE_UP>;
        bindings = <&kp LC(TAB)>;          /* Ctrl+Tab: next tab */
    };

    tab_prev {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LS(LC(TAB))>;      /* Ctrl+Shift+Tab: previous tab */
    };
};

/ {
    deadzone_processor: deadzone_processor {
        compatible = "zmk,input-processor-deadzone";
        #input-processor-cells = <0>;
        threshold = <10>;
        timeout-ms = <300>;
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        /* Chain order:
         *   deadzone      - filter sub-threshold noise
         *   xy_transform  - invert both axes (sensor-mounting orientation)
         *   mouse_gesture - active only while K+L combo held; suppresses
         *                   movement downstream during an active gesture
         *   temp_layer    - auto-mouse-layer -> MOUSE(1), 1000ms timeout,
         *                   excludes J/K/L with 300ms prior-idle requirement
         *   scroll_runtime - convert XY -> scroll on layer 5 only
         *   inertia       - continues movement/scroll after release
         *                   (MUST be last: operates on final values) */
        input-processors = <&deadzone_processor
                            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
                            &zip_mouse_gesture
                            &zip_temp_layer 1 1000
                            &scroll_runtime_input_processor
                            &zip_inertia>;
    };
};

&spi0 {
    status = "okay";

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,paw3222";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        /* Boot-time sensor CPI (counts per inch). Valid range 608-4826 in
         * steps of 38; driver rounds down. 800 maps to 21*38 = 798.
         * DYA Studio's runtime-input-processor can override at runtime. */
        res-cpi = <800>;
    };
};